# Sao chép file này thành ".env" rồi điền giá trị. KHÔNG đưa .env lên git (thêm ".env" vào .gitignore).
# Dòng bắt đầu bằng # là chú thích. Giá trị có ký tự # hoặc khoảng trắng thì đặt trong dấu nháy kép.

# --- Tài khoản (bí mật) ---
ED_USERNAME=
ED_PASS=

# --- Địa chỉ web (đổi khi trường đổi máy chủ) ---
ED_HOME_URL=https://ed22.engdis.com/ptithcm#/home
ED_PROGRESS_URL=https://ed22.engdis.com/ptithcm#/MyProgress/Course/{id}/Unit/

# --- Khai báo khóa học: ED_COURSE_<TÊN>=<id>. Thêm khóa mới = thêm 1 dòng ---
ED_COURSE_I2=45178
ED_COURSE_I3=45441

# --- Chọn khóa mặc định (I2 / I3). Để trống = chương trình sẽ hỏi. Tham số --course hoặc --I2/--I3 ghi đè dòng này ---
ED_COURSE=I3

# --- Bài cần lấy. Để TRỐNG = chế độ thủ công (tự gõ nhãn như hiện nay) ---
# Ví dụ:  ALL  |  U02  |  U02..U04  |  U02-L03  |  U02-L01..L03  |  U01,U03-L02  |  I2-U02-L02-Cliff Terror
# Số unit/lesson là thứ tự hiển thị trên web (1, 2, 3...). Tên bài ở cuối chỉ để dễ đọc.
ED_TARGETS=

# --- Giây nghỉ giữa các thao tác (đừng đặt quá thấp) ---
ED_DELAY=3
